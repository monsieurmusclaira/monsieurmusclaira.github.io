---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilmCard from "../components/FilmCard.astro";
import VideoCard from "../components/VideoCard.astro";
import { getCollection } from "astro:content";
import { sortByOrder } from "../lib/projects";

const all = await getCollection("projects");
const films = sortByOrder(all.map((e) => ({ slug: e.id, ...e.data.card, director: e.data.director, title: e.data.title, year: e.data.year, role: e.data.role })));
const featuredFilms = films.slice(0, 8);
---

<BaseLayout title="Victor Maes — Cinematographer & Director | Belgium" description="Award-winning Belgium-based cinematographer and director creating fiction, documentaries, VR experiences and experimental films for audiences worldwide." image="/video/seethrough.jpg">
  <VideoCard />
  <section id="selected-work" aria-labelledby="selected-work-heading">
    <h2 id="selected-work-heading" class="sr-only">Selected work</h2>
  {featuredFilms.map((f) => (
    <FilmCard
      title={f.title}
      img={f.image}
      imageposition={f.position}
      desc={f.desc ?? `by ${f.director}`}
      url={`/projects/${f.slug}/`}
      badge1={f.badge1}
      badge2={f.badge2}
      target="_self"
    />
  ))}
  </section>

  <div class="bg-neutral px-6 pb-20 text-center">
    <a href="#all-work" class="inline-flex items-center rounded-sm border border-base-100/40 px-5 py-3 font-sans text-xs tracking-[0.16em] uppercase text-base-100/80 transition-colors duration-200 hover:border-secondary hover:text-secondary focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-secondary focus-visible:outline-offset-2">Browse all work <span class="ml-2" aria-hidden="true">&darr;</span></a>
  </div>

  <section id="all-work" class="bg-neutral py-24 px-6 scroll-mt-24" data-aos="fade-up" data-aos-duration="600">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-sans text-sm tracking-[0.2em] uppercase text-base-100/60 text-center pb-3">All work</h2>
      <p class="text-center text-base-100/60 font-serif text-lg pb-10">Fiction, documentary, VR and experimental films.</p>
      <ul class="divide-y divide-base-100/10">
        {films.map((f) => (
          <li>
            <a href={`/projects/${f.slug}/`} class="group flex flex-col sm:flex-row sm:items-baseline gap-0.5 sm:gap-4 py-4 focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-secondary">
              <span class="text-xl text-warning group-hover:text-secondary transition-colors duration-300">{f.title}</span>
              <span class="text-sm italic text-base-100/60">by {f.director}</span>
              <span class="sm:ml-auto font-sans text-xs tracking-widest uppercase text-base-100/60 group-hover:text-base-100/70 transition-colors duration-300">
                {[f.badge1, f.year].filter(Boolean).join(' · ')}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

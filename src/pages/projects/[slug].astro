---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectPage from "../../components/ProjectPage.astro";
import type { InferGetStaticPropsType } from "astro";
import { sortByOrder, nextSlug, prevSlug, validateProjectOrder, requireProject } from "../../lib/projects";

export async function getStaticPaths() {
  const all = await getCollection("projects");
  const ordered = sortByOrder(all.map((e) => ({ slug: e.id, order: e.data.card.order })));
  validateProjectOrder(ordered);
  return all.map((entry) => {
    const ns = nextSlug(entry.id, ordered);
    const nextEntry = requireProject(all, ns);
    const ps = prevSlug(entry.id, ordered);
    const prevEntry = requireProject(all, ps);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        next: {
          title: nextEntry.data.title,
          url: `/projects/${nextEntry.id}/`,
          image: nextEntry.data.card.image,
          position: nextEntry.data.card.position,
        },
        prev: {
          title: prevEntry.data.title,
          url: `/projects/${prevEntry.id}/`,
        },
      },
    };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, next, prev } = Astro.props;
const { Content } = await render(entry);
const { description, hero } = entry.data;

// Visible pages only show `year` when set; structured data falls back to the
// film's own recorded featured-award year.
const resolvedYear = entry.data.year ?? entry.data.featuredAward?.year;

// Each project owns a curated, descriptive title in frontmatter so search
// results retain the film type and cinematography/direction intent.
const headTitle = entry.data.seoTitle;
---

<BaseLayout
  title={headTitle}
  description={description}
  image={hero.image}
  imageAlt={hero.alt}
  frontmatter={{
    director: entry.data.director,
    genre: entry.data.genre,
    year: resolvedYear,
    schemaType: entry.data.schemaType,
    awards: entry.data.awards,
    featuredAward: entry.data.featuredAward,
    videos: entry.data.videos,
  }}
>
  <ProjectPage data={entry.data} next={next} prev={prev}>
    <Content />
  </ProjectPage>
</BaseLayout>

---
import { ANALYTICS_ID, SITE_URL } from '../config';
const production = import.meta.env.PROD && import.meta.env.PORTFOLIO_ANALYTICS_DISABLED !== 'true';
---
<div id="analytics-settings" data-analytics-id={ANALYTICS_ID} data-site-url={SITE_URL} data-production={String(production)}>
  <section id="analytics-consent" hidden aria-labelledby="analytics-consent-title" tabindex="-1" class="fixed bottom-0 inset-x-0 z-50 border-t border-base-100/20 bg-neutral p-5 sm:p-6 text-base-100 shadow-lg">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row sm:items-center gap-5">
      <div class="flex-1">
        <h2 id="analytics-consent-title" class="font-serif text-xl mb-2">Optional analytics</h2>
        <p class="font-sans text-sm leading-relaxed text-base-100/80">Allow Google Analytics to measure visits and help improve this portfolio? It loads only if you agree. You can change your choice in the footer.</p>
      </div>
      <div class="flex flex-wrap gap-3 font-sans text-sm">
        <button type="button" data-analytics-choice="declined" class="min-h-11 rounded-sm border border-base-100/60 px-4 hover:border-secondary hover:text-secondary">No thanks</button>
        <button type="button" data-analytics-choice="accepted" class="min-h-11 rounded-sm border border-base-100/60 px-4 hover:border-secondary hover:text-secondary">Allow analytics</button>
      </div>
    </div>
  </section>
</div>
<script>
  import { analyticsAllowed, CONSENT_KEY, pageViewKey, type AnalyticsChoice } from '../lib/analytics-policy';
  declare global {
    interface Window {
      dataLayer?: IArguments[];
      gtag?: (...args: unknown[]) => void;
    }
  }
  let choice: AnalyticsChoice | undefined;
  let loaded = false;
  let lastPage: string | undefined;
  let previousPage: string | undefined;
  let returnFocus: HTMLElement | undefined;

  function config() {
    const element = document.getElementById('analytics-settings');
    return element && analyticsAllowed(element.dataset.production === 'true', location.hostname, element.dataset.siteUrl!) ? element : undefined;
  }
  function consentPanel() { return document.getElementById('analytics-consent'); }
  function readChoice() {
    try {
      const stored = localStorage.getItem(CONSENT_KEY);
      if (stored === 'accepted' || stored === 'declined') choice = stored;
    } catch { /* Without storage, retain the choice for this visit only. */ }
  }
  function trackPage() {
    if (!config() || choice !== 'accepted' || !window.gtag) return;
    const page = pageViewKey(location.href);
    if (page === lastPage) return;
    window.gtag('event', 'page_view', {
      page_title: document.title,
      page_location: page,
      page_referrer: previousPage ?? document.referrer,
    });
    lastPage = page;
    previousPage = page;
  }
  function enableAnalytics() {
    const settings = config();
    if (!settings || choice !== 'accepted') return;
    const id = settings.dataset.analyticsId!;
    // Re-enable a previously withdrawn choice in this visit.
    (window as unknown as Record<string, unknown>)[`ga-disable-${id}`] = false;
    if (!loaded) {
      loaded = true;
      window.dataLayer ??= [];
      window.gtag = function () { window.dataLayer!.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('consent', 'default', { analytics_storage: 'granted', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      // Enhanced Measurement history page views must also be disabled in GA4.
      window.gtag('config', id, { send_page_view: false, allow_google_signals: false, allow_ad_personalization_signals: false });
      const script = document.createElement('script');
      script.id = 'portfolio-ga4';
      script.setAttribute('data-astro-transition-persist', 'portfolio-ga4');
      script.dataset.astroExec = ''; // Already executed by this loader, not by Astro's router.
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
      const placeholder = document.getElementById('portfolio-ga4-placeholder');
      if (placeholder) placeholder.replaceWith(script);
      else document.head.append(script);
    } else {
      window.gtag?.('consent', 'update', { analytics_storage: 'granted' });
    }
    trackPage();
  }
  function removeAnalyticsCookies() {
    // GA uses _ga and _ga_<stream> cookies on the current host or parent domain.
    for (const cookie of document.cookie.split(';')) {
      const name = cookie.trim().split('=')[0];
      if (!/^_ga(?:_|$)/.test(name)) continue;
      for (const domain of ['', `; domain=${location.hostname}`, `; domain=.${location.hostname}`]) {
        document.cookie = `${name}=; Max-Age=0; path=/${domain}; SameSite=Lax`;
      }
    }
  }
  function applyChoice(next: AnalyticsChoice) {
    choice = next;
    try { localStorage.setItem(CONSENT_KEY, next); } catch { /* Visit-only choice. */ }
    const panel = consentPanel();
    if (panel) panel.hidden = true;
    if (returnFocus?.isConnected) returnFocus.focus();
    else document.getElementById('main')?.focus({ preventScroll: true });
    returnFocus = undefined;
    if (next === 'accepted') enableAnalytics();
    else {
      const id = config()?.dataset.analyticsId;
      if (id) (window as unknown as Record<string, unknown>)[`ga-disable-${id}`] = true;
      window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
      removeAnalyticsCookies();
      // Drop queued views if the choice changes before the remote tag arrives.
      if (window.dataLayer) {
        for (let i = window.dataLayer.length - 1; i >= 0; i--) {
          if (window.dataLayer[i][0] === 'event') window.dataLayer.splice(i, 1);
        }
      }
      lastPage = undefined;
    }
  }
  function setup() {
    if (!config()) return;
    readChoice();
    const panel = consentPanel();
    if (panel) panel.hidden = choice !== undefined;
    document.querySelectorAll<HTMLButtonElement>('[data-analytics-settings]').forEach((button) => { button.hidden = false; });
    if (choice === 'accepted') enableAnalytics();
  }
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : undefined;
    const settingsButton = target?.closest<HTMLElement>('[data-analytics-settings]');
    if (settingsButton && config()) {
      returnFocus = settingsButton;
      const panel = consentPanel();
      if (panel) { panel.hidden = false; panel.focus({ preventScroll: true }); }
    }
    const button = target?.closest<HTMLElement>('[data-analytics-choice]');
    if (button && config()) applyChoice(button.dataset.analyticsChoice as AnalyticsChoice);
  });
  document.addEventListener('astro:page-load', setup);
  window.addEventListener('pageshow', setup);
</script>

---
import type { IntroFact } from '../lib/projects';
interface Props { synopsis?: string; items?: IntroFact[]; }
const { synopsis, items = [] } = Astro.props;
const facts = items.filter((i) => i && i.value);
const padding = synopsis ? 'py-16 sm:py-24' : 'py-12 sm:py-16';
---
<section id="project-intro" class={`hero ${padding} bg-neutral scroll-mt-20`} aria-labelledby="project-intro-heading">
  <div class="hero-content flex-col max-w-3xl mx-auto px-6 text-center" data-aos="fade-up" data-aos-duration="600">
    <h2 id="project-intro-heading" class="font-sans text-[11px] tracking-[0.2em] uppercase text-base-100/60 mb-7">
      {synopsis ? 'The story' : 'Project details'}
    </h2>
    {synopsis && (
      <p class="font-serif text-xl sm:text-2xl leading-relaxed text-base-100/90">
        {synopsis}
      </p>
    )}
    {facts.length > 0 && (
      <dl class={`flex flex-wrap justify-center gap-x-10 gap-y-6 ${synopsis ? 'mt-12 pt-10 border-t border-base-100/15 w-full' : ''}`}>
        {facts.map((f) => (
          <div class="text-center">
            <dt class="font-sans text-[11px] tracking-widest uppercase text-base-100/60">
              {f.label}
            </dt>
            <dd class="font-sans text-base font-light text-base-100/85 mt-1.5">
              {f.value}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

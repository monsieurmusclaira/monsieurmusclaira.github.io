---
interface Props { label: string; values?: string[]; }
const { label, values = [] } = Astro.props;
---
<div
  data-spec-group
  class="grid grid-cols-[minmax(7rem,0.85fr)_minmax(0,1.15fr)] gap-x-5 border-t border-base-100/10 pt-4"
>
  <dt class="text-right pt-0.5">
    <span class="font-sans text-[10px] leading-relaxed tracking-widest uppercase text-base-100/60">
      {label}
    </span>
  </dt>
  <dd class="min-w-0">
    <ul class="space-y-1.5">
      {values.map((value) => (
        <li class="font-sans text-sm leading-relaxed font-light text-base-100/80 break-words">
          {value}
        </li>
      ))}
    </ul>
  </dd>
</div>

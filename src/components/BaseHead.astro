---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { sortByOrder } from '../lib/projects';
import { publicSocialImage } from '../lib/social-images';
import { videoDetails } from '../lib/videos';
import { resolveImage, listBtsImages } from '../utils/images';
import { SITE_TITLE, SITE_URL, SITE_NAME, SOCIAL_LINKS } from '../config';
import type { ProjectData } from '../lib/projects';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import ebGaramond400 from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';

export interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	canonical?: string;
	schema?: object;
	noindex?: boolean;
	director?: string;
	genre?: string;
	projectTitle?: string;
	role?: string;
	schemaType?: string;
	awards?: ProjectData['awards'];
	featuredAward?: ProjectData['featuredAward'];
	videos?: ProjectData['videos'];
}

const { title, description, image, imageAlt, canonical, schema, noindex, director, genre, projectTitle: suppliedProjectTitle, role, schemaType, awards, featuredAward, videos } = Astro.props;

// Social-card image alt: describe the actual photo when the page provides it,
// otherwise fall back to the page title.
const imageAltText = imageAlt || title;

const canonicalURL = canonical ? new URL(canonical, SITE_URL) : new URL(Astro.url.pathname, SITE_URL);

// A public image is explicitly registered and checked on disk. Managed image
// failures propagate through the build instead of silently publishing a bad URL.
let ogImage: string | null = null;
let ogImageWidth: number | null = null;
let ogImageHeight: number | null = null;
if (image) {
  const publicDimensions = publicSocialImage(image);
  if (publicDimensions) {
    ogImage = new URL(image, SITE_URL).href;
    ogImageWidth = publicDimensions.width;
    ogImageHeight = publicDimensions.height;
  } else {
    const optimized = await getImage({ src: await resolveImage(image), format: 'jpeg', width: 1200 });
    ogImage = new URL(optimized.src, SITE_URL).href;
    ogImageWidth = optimized.attributes.width ?? null;
    ogImageHeight = optimized.attributes.height ?? null;
  }
}

const pageType = Astro.url.pathname.startsWith('/projects/') ? 'project' 
  : Astro.url.pathname === '/' || Astro.url.pathname === '' ? 'home'
  : Astro.url.pathname.startsWith('/about') ? 'about'
  : Astro.url.pathname.startsWith('/behind-the-scenes') ? 'bts'
  : 'page';

// Use a video object type only when the project actually has an embedded video.
const ogType = pageType === 'project' && (videos?.length ?? 0) > 0 ? 'video.other' : 'website';

// Build JSON-LD schemas
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  "name": SITE_NAME,
  "jobTitle": "Cinematographer, Director of Photography and Director",
  "description": `${SITE_NAME} is a cinematographer, director of photography and director based in Belgium`,
  "url": SITE_URL,
  "sameAs": Object.values(SOCIAL_LINKS),
  "knowsAbout": ["Cinematography", "Film", "Virtual Reality", "Documentary", "Director of Photography"],
  "knowsLanguage": ["en", "fr", "nl"],
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "BE"
  }
};

// Google requires ProfilePage.mainEntity to resolve directly to a Person or
// Organization. Include the required type and name alongside the shared @id;
// the full Person node above supplies the remaining details in the same graph.
const personReference = {
  "@id": `${SITE_URL}/#person`,
  "@type": "Person",
  "name": SITE_NAME
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "name": SITE_TITLE,
  "url": SITE_URL,
  "publisher": {
    "@id": `${SITE_URL}/#person`
  }
};

// Homepage filmography: the films in card.order, as an ItemList.
let filmographySchema: object | null = null;
if (pageType === 'home') {
  const entries = await getCollection('projects');
  const ordered = sortByOrder(
    entries.map((e) => ({ slug: e.id, order: e.data.card.order, name: e.data.title })),
  );
  filmographySchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${SITE_URL}/#filmography`,
    "name": `Filmography | ${SITE_NAME}`,
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "numberOfItems": ordered.length,
    "itemListElement": ordered.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": p.name,
      "url": `${SITE_URL}/projects/${p.slug}/`,
    })),
  };
}

let pageSchema: object | null = null;

if (pageType === 'home') {
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/`,
    "url": `${SITE_URL}/`,
    "name": title,
    "description": description,
    "about": personReference,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else if (pageType === 'project') {
  const projectTitle = suppliedProjectTitle;
  if (!projectTitle || !role) throw new Error('Project metadata needs its exact title and credited role.');
  const projectType = schemaType || 'Movie';
  const isMovie = projectType === 'Movie';
  const directors = director?.split(' & ').map((name) => ({ '@type': 'Person', name }));

  // Award strings from the film's own recorded featured award + awards list.
  // The featured award is often repeated in the awards list, so dedupe.
  const awardList = [...new Set(
    [...(featuredAward ? [featuredAward] : []), ...(awards ?? [])]
      .map((a) => [a.award, a.festival, a.year].filter(Boolean).join(', '))
  )];

  const videoObjects = (videos ?? []).map((video) => {
    const details = videoDetails(video, projectTitle);
    return {
      '@type': 'VideoObject',
      name: details.name,
      description: details.description ?? `${details.name}. ${description}`,
      ...(ogImage ? { thumbnailUrl: ogImage } : {}),
      embedUrl: details.embedUrl,
      ...(details.uploadDate ? { uploadDate: details.uploadDate } : {}),
    };
  });

  pageSchema = {
    "@context": "https://schema.org",
    "@type": projectType,
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": projectTitle,
    "description": description,
    ...(ogImage ? { "image": ogImage } : {}),
    ...(directors ? (isMovie ? { director: directors } : { creator: directors }) : {}),
    ...(genre ? { "genre": genre } : {}),

    ...(awardList.length ? { "award": awardList } : {}),
    ...(videoObjects.length ? (isMovie ? { trailer: videoObjects } : { video: videoObjects }) : {}),
    "contributor": personReference,
    "creditText": `${SITE_NAME}: ${role}`,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else if (pageType === 'about') {
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
    "mainEntity": personReference,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else if (pageType === 'bts') {
  // Representative subset of the polaroid photos (up to 5 per film) as
  // ImageObject entries. width 1200 matches the lightbox variant, so no
  // extra image files are generated for this.
  const btsMedia: object[] = [];
  for (const img of await listBtsImages(5)) {
    const opt = await getImage({ src: img, width: 1200 });
    btsMedia.push({ "@type": "ImageObject", "contentUrl": new URL(opt.src, SITE_URL).toString() });
  }
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
    ...(ogImage ? { "image": ogImage } : {}),
    ...(btsMedia.length ? { "associatedMedia": btsMedia } : {}),
    "about": {
      "@id": `${SITE_URL}/#person`
    },
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else {
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
}

// The homepage is the breadcrumb root, so it gets no trail of its own.
const breadcrumbSchema = pageType === 'home' ? null : {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${SITE_URL}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title.split(' | ')[0].split(' — ')[0].replace(/\s*\(\d{4}\)$/, '').trim(),
      "item": canonicalURL.toString()
    }
  ]
};

const schemas = [personSchema, websiteSchema, pageSchema, breadcrumbSchema, filmographySchema].filter(Boolean);
if (schema) {
  schemas.push(schema);
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#000000" />
<meta name="color-scheme" content="dark" />

<!-- Canonical & Hreflang -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- LCP preload: hero video poster on home page -->
{pageType === 'home' && <link rel="preload" as="image" href="/video/seethrough.webp" type="image/webp" fetchpriority="high" />}

<!-- Critical local fonts: bundled through Fontsource, never fetched at build time. -->
<link rel="preload" href={montserrat400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={ebGaramond400} as="font" type="font/woff2" crossorigin />

<!-- Crawl directives -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_BE" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && (
  <>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAltText} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && (
  <>
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAltText} />
  </>
)}

<!-- JSON-LD Schema -->
<script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/</g, '\\u003c')} />


<!-- Retain the analytics loader across Astro navigation. -->
<script is:inline type="text/plain" id="portfolio-ga4-placeholder" data-astro-transition-persist="portfolio-ga4"></script>

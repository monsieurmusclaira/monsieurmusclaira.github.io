---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { sortByOrder } from '../lib/projects';
import { GoogleAnalytics } from 'astro-google-analytics';
import { resolveImage, listBtsImages } from '../utils/images';
import { SITE_TITLE, SITE_URL } from '../config';
import montserrat400 from '@fontsource/montserrat/files/montserrat-latin-400-normal.woff2?url';
import ebGaramond400 from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';

export interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	canonical?: string;
	schema?: object;
	noindex?: boolean;
	director?: string;
	genre?: string;
	year?: string;
	schemaType?: string;
	awards?: { award: string; festival: string; year?: string }[];
	featuredAward?: { award: string; festival: string; year?: string };
	videos?: { provider: string; id: string; title?: string }[];
}

const { title, description, image, imageAlt, canonical, schema, noindex, director, genre, year, schemaType, awards, featuredAward, videos } = Astro.props;

// Social-card image alt: describe the actual photo when the page provides it,
// otherwise fall back to the page title.
const imageAltText = imageAlt || title;

const canonicalURL = canonical ? new URL(canonical, SITE_URL) : new URL(Astro.url.pathname, SITE_URL);

// Social-card images served straight from /public bypass the image pipeline, so
// their intrinsic size is recorded here (measured with sips). Keeps og:image
// width and height present on pages whose card is a public asset.
const PUBLIC_IMAGE_DIMS: Record<string, { width: number; height: number }> = {
  '/video/seethrough.jpg': { width: 1800, height: 800 },
};

// Social-card image: src/assets paths get optimized to a 1200px JPEG;
// public paths (e.g. /video/seethrough.jpg) pass through as-is.
let ogImage: string | null = null;
let ogImageWidth: number | null = null;
let ogImageHeight: number | null = null;
if (image) {
  try {
    const optimized = await getImage({ src: resolveImage(image), format: 'jpeg', width: 1200 });
    ogImage = new URL(optimized.src, SITE_URL).toString();
    ogImageWidth = optimized.attributes.width ?? null;
    ogImageHeight = optimized.attributes.height ?? null;
  } catch {
    ogImage = new URL(image, SITE_URL).toString();
    const dims = PUBLIC_IMAGE_DIMS[image];
    if (dims) {
      ogImageWidth = dims.width;
      ogImageHeight = dims.height;
    }
  }
}

const pageType = Astro.url.pathname.startsWith('/projects/') ? 'project' 
  : Astro.url.pathname === '/' || Astro.url.pathname === '' ? 'home'
  : Astro.url.pathname.startsWith('/about') ? 'about'
  : Astro.url.pathname.startsWith('/behind-the-scenes') ? 'bts'
  : 'page';

// Use a video object type only when the project actually has an embedded video.
const ogType = pageType === 'project' && (videos?.length ?? 0) > 0 ? 'video.other' : 'website';

// Build JSON-LD schemas
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/#person`,
  "name": "Victor Maes",
  "jobTitle": "Cinematographer, Director of Photography and Director",
  "description": "Victor Maes is a cinematographer, director of photography and director based in Belgium",
  "url": SITE_URL,
  "sameAs": [
    "https://www.instagram.com/monsieur_musclaira/",
    "https://www.linkedin.com/in/victor-maes/",
    "https://www.imdb.com/name/nm4866929"
  ],
  "knowsAbout": ["Cinematography", "Film", "Virtual Reality", "Documentary", "Director of Photography"],
  "knowsLanguage": ["en", "fr", "nl"],
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "BE"
  }
};

// Google requires ProfilePage.mainEntity to resolve directly to a Person or
// Organization. Include the required type and name alongside the shared @id;
// the full Person node above supplies the remaining details in the same graph.
const personReference = {
  "@id": `${SITE_URL}/#person`,
  "@type": "Person",
  "name": "Victor Maes"
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "name": SITE_TITLE,
  "url": SITE_URL,
  "publisher": {
    "@id": `${SITE_URL}/#person`
  }
};

// Homepage filmography: the films in card.order, as an ItemList.
let filmographySchema: object | null = null;
if (pageType === 'home') {
  const entries = await getCollection('projects');
  const ordered = sortByOrder(
    entries.map((e) => ({ slug: e.id, order: e.data.card.order, name: e.data.title })),
  );
  filmographySchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": `${SITE_URL}/#filmography`,
    "name": "Filmography | Victor Maes",
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "numberOfItems": ordered.length,
    "itemListElement": ordered.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": p.name,
      "url": `${SITE_URL}/projects/${p.slug}/`,
    })),
  };
}

let pageSchema: object | null = null;

if (pageType === 'home') {
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/`,
    "url": `${SITE_URL}/`,
    "name": title,
    "description": description,
    "about": personReference,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else if (pageType === 'project') {
  // Strip the head-title decoration back to the bare film name: the role suffix
  // after ' | ', the old ' — ' template arm, and the year parenthetical.
  const projectTitle = title.split(' | ')[0].split(' — ')[0].replace(/\s*\(\d{4}\)$/, '').trim();
  const projectType = schemaType || 'Movie';
  const isMovie = projectType === 'Movie';

  // Only emit dates when the source contains a complete date. A bare project
  // year is useful editorially but should not become a fabricated January 1.
  const exactDate = year && /^\d{4}-\d{2}-\d{2}$/.test(year) ? year : undefined;

  // Award strings from the film's own recorded featured award + awards list.
  // The featured award is often repeated in the awards list, so dedupe.
  const awardList = [...new Set(
    [featuredAward, ...(awards ?? [])]
      .filter(Boolean)
      .map((a) => [a.award, a.festival, a.year].filter(Boolean).join(', '))
  )];

  // First video becomes a trailer VideoObject. The film's own optimized still
  // (ogImage) serves as the thumbnail, so the entity is always valid.
  // Video ids should be bare ids, but MDX has historically carried full watch
  // URLs. Normalize so the embedUrl is always valid regardless of what the
  // content file stores. Mirrors what astro-embed-youtube does for the player.
  const videoId = (raw: string): string => {
    if (/^[A-Za-z0-9_-]+$/.test(raw)) return raw;
    const yt = raw.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/)([A-Za-z0-9_-]{6,})/);
    if (yt) return yt[1];
    const vimeo = raw.match(/vimeo\.com\/(?:video\/)?(\d+)/);
    if (vimeo) return vimeo[1];
    return raw;
  };

  const firstVideo = (videos ?? [])[0];
  let trailer: object | null = null;
  if (firstVideo && ogImage) {
    const cleanId = videoId(String(firstVideo.id));
    const embedUrl = firstVideo.provider === 'youtube'
      ? `https://www.youtube.com/embed/${cleanId}`
      : `https://player.vimeo.com/video/${cleanId}`;
    trailer = {
      "@type": "VideoObject",
      "name": `${projectTitle} — Trailer`,
      "description": description,
      "thumbnailUrl": ogImage,
      "embedUrl": embedUrl
    };
  }

  pageSchema = {
    "@context": "https://schema.org",
    "@type": projectType,
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": projectTitle,
    "description": description,
    ...(ogImage ? { "image": ogImage } : {}),
    ...(director ? { "director": director.split(' & ').map((name) => ({ "@type": "Person", "name": name })) } : {}),
    ...(genre ? { "genre": genre } : {}),
    ...(exactDate ? { "datePublished": exactDate } : {}),
    ...(awardList.length ? { "award": awardList } : {}),
    ...(trailer ? { "trailer": trailer } : {}),
    ...(isMovie ? {
      "cinematographer": {
        "@type": "Person",
        "name": "Victor Maes",
        "url": SITE_URL
      }
    } : {}),
    "creator": {
      "@id": `${SITE_URL}/#person`
    },
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else if (pageType === 'about') {
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
    "mainEntity": personReference,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else if (pageType === 'bts') {
  // Representative subset of the polaroid photos (up to 5 per film) as
  // ImageObject entries. width 1200 matches the lightbox variant, so no
  // extra image files are generated for this.
  const btsMedia: object[] = [];
  for (const img of listBtsImages(5)) {
    try {
      const opt = await getImage({ src: img, width: 1200 });
      btsMedia.push({ "@type": "ImageObject", "contentUrl": new URL(opt.src, SITE_URL).toString() });
    } catch {
      // skip images the pipeline cannot process
    }
  }
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
    ...(ogImage ? { "image": ogImage } : {}),
    ...(btsMedia.length ? { "associatedMedia": btsMedia } : {}),
    "about": {
      "@id": `${SITE_URL}/#person`
    },
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
} else {
  pageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonicalURL.toString(),
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
    "isPartOf": {
      "@id": `${SITE_URL}/#website`
    }
  };
}

// The homepage is the breadcrumb root, so it gets no trail of its own.
const breadcrumbSchema = pageType === 'home' ? null : {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${SITE_URL}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": title.split(' | ')[0].split(' — ')[0].replace(/\s*\(\d{4}\)$/, '').trim(),
      "item": canonicalURL.toString()
    }
  ]
};

const schemas = [personSchema, websiteSchema, pageSchema, breadcrumbSchema, filmographySchema].filter(Boolean);
if (schema) {
  schemas.push(schema);
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#000000" />
<meta name="color-scheme" content="dark" />

<!-- Canonical & Hreflang -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="en" href={canonicalURL} />
<link rel="alternate" hreflang="x-default" href={canonicalURL} />

<!-- LCP preload: hero video poster on home page -->
{pageType === 'home' && <link rel="preload" as="image" href="/video/seethrough.webp" type="image/webp" fetchpriority="high" />}

<!-- Critical local fonts: bundled through Fontsource, never fetched at build time. -->
<link rel="preload" href={montserrat400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={ebGaramond400} as="font" type="font/woff2" crossorigin />

<!-- Performance: Preconnect -->
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />

<!-- Crawl directives -->
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_BE" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && (
  <>
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAltText} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
  </>
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && (
  <>
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAltText} />
  </>
)}

<!-- JSON-LD Schema -->
<script type="application/ld+json" set:html={JSON.stringify(schemas)} />

<!-- Google Analytics (production builds only — never fires in dev) -->
{import.meta.env.PROD && <GoogleAnalytics id="G-1P80SYF663" />}

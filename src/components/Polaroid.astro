---
import GalleryImage from './GalleryImage.astro';
import { polaroidSizes } from '../lib/gallery-layout';
interface Props { image: string; alt: string; caption?: string; }
const { image, alt, caption } = Astro.props;
---
<figure class="polaroid">
  <GalleryImage image={image} alt={alt} caption={caption} sizes={polaroidSizes} widths={[384, 768, 960]} fullWidth={1200} class="polaroid-btn" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

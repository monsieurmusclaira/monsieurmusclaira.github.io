<section class="home-hero relative min-h-dvh w-full bg-black" aria-labelledby="home-role">
	<div class="home-hero-frame">
	<video class="home-hero-video" width="1800" height="800"
			loop muted playsinline preload="none" poster="/video/seethrough.webp" id="hero-video" aria-hidden="true">
		<!-- Sources are loaded by the script below only on larger screens with motion
		     allowed, so phones and reduced-motion users get the poster instead of a
		     multi-megabyte download. WebM first (Firefox/Chrome), MP4 fallback (Safari/iOS). -->
		<source type="video/webm" data-src="/video/seethrough-loop.webm" />
		<source type="video/mp4" data-src="/video/seethrough-loop.mp4" />
		Your browser does not support the video
		</video>
	<div class="home-hero-copy z-10 text-center">
    <h1 id="home-role" class="font-serif text-base-100/85">Cinematographer &amp; Director</h1>
    <p class="mt-3 font-sans text-[10px] tracking-[0.18em] uppercase text-muted">Belgium · Fiction, documentary &amp; VR</p>
  </div>
	</div>
	<a href="#selected-work" aria-label="Scroll to selected work" class="drop-in-3 text-secondary absolute bottom-6 z-10 inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
	<svg class="scroll-cue" width="28" height="28" viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
		<path d="M7.5 2C7.77614 2 8 2.22386 8 2.5L8 11.2929L11.1464 8.14645C11.3417 7.95118 11.6583 7.95118 11.8536 8.14645C12.0488 8.34171 12.0488 8.65829 11.8536 8.85355L7.85355 12.8536C7.65829 13.0488 7.34171 13.0488 7.14645 12.8536L3.14645 8.85355C2.95118 8.65829 2.95118 8.34171 3.14645 8.14645C3.34171 7.95118 3.65829 7.95118 3.85355 8.14645L7 11.2929L7 2.5C7 2.22386 7.22386 2 7.5 2Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"/>
	</svg>
	</a>
</section>

<style>
  .home-hero { display: flex; align-items: flex-end; justify-content: center; }
  .home-hero-frame { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(100%, 800px); }
  .home-hero-video { display: block; width: 100%; height: auto; max-height: 50dvh; object-fit: contain; }
  .home-hero-copy { position: absolute; top: 100%; width: 100%; padding: clamp(20px, 3vh, 32px) 24px 0; }
  .home-hero-copy h1 { font-size: clamp(1.125rem, 2vw, 1.5rem); font-weight: 400; font-style: italic; line-height: 1.4; letter-spacing: 0.04em; }
  @media (max-height: 650px) { .home-hero-video { max-height: 32dvh; } }
  @media (max-height: 560px) { .home-hero { min-height: 560px; } }
</style>

<script>
  import { attachHeroVideo } from '../lib/hero-video';

  // Bundled once by Astro; release the old video on client navigation.
  let cleanup: (() => void) | undefined;
  function setup() {
    cleanup?.();
    cleanup = undefined;
    const video = document.querySelector<HTMLVideoElement>('#hero-video');
    if (video) cleanup = attachHeroVideo(video);
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

---
import GalleryImage from './GalleryImage.astro';
interface Props { image: string; alt: string; caption?: string; contained?: boolean; sizes?: string; widths?: number[]; }
const { image, alt, caption, contained = false, sizes, widths = [384, 768, 1152, 1920, 2560] } = Astro.props;
const displaySizes = sizes ?? (contained ? '(min-width: 1024px) 976px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)' : '100vw');
const triggerClass = contained ? 'lightbox-trigger w-full max-w-5xl mx-auto px-4 sm:px-6' : 'lightbox-trigger w-full';
---
<section class="hero" data-aos="fade-up">
  <GalleryImage image={image} alt={alt} caption={caption} sizes={displaySizes} widths={widths} class={triggerClass} />
</section>

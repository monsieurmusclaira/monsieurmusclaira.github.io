---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/images';
const { image, alt, contained = false } = Astro.props;
// Stable id derived from the full image path, so two images that share a
// basename across folders (common on the behind-the-scenes board) cannot
// collide, and builds stay deterministic.
const slug = image.replace(/\.[^.]+$/, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const id = `lb-${slug}`;
const resolved = resolveImage(image);
const buttonClass = contained
  ? 'lightbox-trigger w-full max-w-5xl mx-auto px-4 sm:px-6 bg-transparent border-0 p-0 cursor-zoom-in'
  : 'lightbox-trigger w-full bg-transparent border-0 p-0 cursor-zoom-in';
---
<section class="hero" data-aos="fade-up">
  <button
    id={`${id}-trigger`}
    class={buttonClass}
    onclick={`(function(trigger){var dialog=document.getElementById('${id}'); if (!dialog.open) dialog.showModal(); document.getElementById('${id}-close').focus();})(this)`}
    aria-label={`View full size: ${alt}`}
  >
    <Image
      src={resolved}
      loading="lazy"
      alt={alt}
      class="w-full h-auto block"
      width={2560}
      widths={[768, 1080, 1440, 2560]}
      sizes={contained ? '(min-width: 1024px) 1024px, 100vw' : '100vw'}
    />
  </button>

  <dialog id={id} class="lightbox" aria-label={`Image: ${alt}`} oncancel="event.preventDefault(); this.close()" onkeydown="if (event.key === 'Escape') { event.preventDefault(); this.close(); }" onclose={`document.getElementById('${id}-trigger')?.focus()`} onclick="if (event.target === this) this.close()">
    <button id={`${id}-close`} type="button" class="lightbox-close" aria-label="Close image" onclick="this.closest('dialog').close()">&#215;</button>
    <Image src={resolved} alt={alt} width={2560} widths={[1440, 2560]} sizes="90vw" loading="lazy" />
  </dialog>
</section>

<style>
  .lightbox {
    /* Tailwind v4 preflight resets margin:0 on every element incl. <dialog>,
       which kills the default modal-dialog centering. Restore it. */
    margin: auto;
    background: transparent;
    border: none;
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
  }
  .lightbox-trigger:hover img,
  .lightbox-trigger:active img {
    filter: saturate(1.08) contrast(1.05);
  }
  .lightbox-trigger:focus-visible {
    outline: 3px solid #f1d74e;
    outline-offset: 4px;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
  }
  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    display: block;
  }
  .lightbox-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, outline-color 150ms ease;
  }
  .lightbox-close:hover,
  .lightbox-close:active {
    background: rgba(241, 215, 78, 0.9);
    color: #111;
  }
  .lightbox-close:focus-visible {
    outline: 3px solid #f1d74e;
    outline-offset: 3px;
  }
</style>

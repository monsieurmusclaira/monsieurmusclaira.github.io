---
import ProjectHero from "./ProjectHero.astro";
import ProjectIntro from "./ProjectIntro.astro";
import SectionLabel from "./SectionLabel.astro";
import FeaturedAward from "./FeaturedAward.astro";
import ContentYoutube from "./ContentYoutube.astro";
import ContentVimeo from "./ContentVimeo.astro";
import ContentPicture from "./ContentPicture.astro";
import CreditsItem from "./CreditsItem.astro";
import FestivalList from "./FestivalList.astro";
import AwardItem from "./AwardItem.astro";
import SpecItem from "./SpecItem.astro";
import NextProject from "./NextProject.astro";
import { resolveImage } from "../utils/images";
import type { ProjectData, NextProjectLink, ProjectLink, IntroFact } from "../lib/projects";
import { gallerySizes } from '../lib/gallery-layout';

interface Props {
  data: ProjectData;
  next: NextProjectLink;
  prev: ProjectLink;
}

const { data, next, prev } = Astro.props;
const videos = data.videos ?? [];
const gallery = data.gallery ?? [];
const credits = data.credits ?? [];
const festivals = data.festivals ?? [];
const awards = data.awards ?? [];
const specs = data.specs ?? [];
const lists = data.lists ?? [];
const laurels = data.laurels ?? [];
const introItems: IntroFact[] = [
  ...(data.year ? [{ label: "Year", value: data.year }] : []),
  { label: "Format", value: data.format },
  { label: "Role", value: data.role },
  { label: "Director", value: data.director },
];
// Credits are stored as a flat list in which a non-empty `function` opens a
// department and subsequent empty functions belong to it. Keep each department
// together, then split on the group boundary closest to an even name count.
const creditGroups: ProjectData["credits"][] = [];
for (const c of credits) {
  if (c.function && c.function.trim()) creditGroups.push([c]);
  else if (creditGroups.length) creditGroups[creditGroups.length - 1].push(c);
  else creditGroups.push([c]);
}
let splitAt = creditGroups.length;
let bestCost = Infinity;
let running = 0;
for (let i = 0; i < creditGroups.length - 1; i++) {
  running += creditGroups[i].length;
  const cost = Math.abs(running - (credits.length - running));
  if (cost < bestCost) {
    bestCost = cost;
    splitAt = i + 1;
  }
}
const creditGroupsLeft = creditGroups.slice(0, splitAt);
const creditGroupsRight = creditGroups.slice(splitAt);
const specGroups: ProjectData["specs"][] = [];
for (const spec of specs) {
  if (spec.label && spec.label.trim()) specGroups.push([spec]);
  else if (specGroups.length) specGroups[specGroups.length - 1].push(spec);
  else specGroups.push([spec]);
}
---

<ProjectHero
  title={data.title}
  credit={data.hero.credit}
  heroImage={data.hero.image}
  alt={data.hero.alt}
  imageposition={data.hero.position}
  scrollTarget="project-intro"
/>

<ProjectIntro synopsis={data.synopsis} items={introItems} />

{videos.map((v) =>
  v.provider === "youtube" ? (
    <ContentYoutube YoutubeLink={v.id} />
  ) : (
    <ContentVimeo VimeoId={v.id} title={v.title} />
  ),
)}

<div class="project-copy">
  <slot />
</div>

{gallery.length > 0 && (
  <section class="hero pt-12 pb-8" aria-labelledby="project-stills-heading">
    <h2 id="project-stills-heading" class="sr-only">Stills</h2>
    <div class="hero-content grid w-full grid-cols-1 md:grid-cols-2 gap-x-3 gap-y-10 max-w-6xl mx-auto px-4">
      {gallery.map((g, i) => {
        const isLastOdd = gallery.length % 2 === 1 && i === gallery.length - 1;
        const layout = g.layout ?? (isLastOdd ? "wide" : "grid");
        const isWide = layout === "wide" || layout === "full";
        const isFull = layout === "full";
        return (
          <figure
            class:list={[
              "gallery-item w-full",
              isWide && "md:col-span-2",
              isWide && !isFull && "max-w-4xl mx-auto",
              isFull && "md:-mx-4 md:w-[calc(100%+2rem)]",
            ]}
            data-gallery-layout={layout}
          >
            <ContentPicture image={g.image} alt={g.alt} caption={g.caption} sizes={gallerySizes[layout]} widths={layout === 'grid' ? [384, 576, 768, 1152] : [384, 768, 1152, 1920, 2560]} />
            {g.caption && (
              <figcaption class="px-2 pt-3 text-center font-sans text-[11px] tracking-widest uppercase text-base-100/50">
                {g.caption}
              </figcaption>
            )}
          </figure>
        );
      })}
    </div>
  </section>
)}

{data.featuredAward && (
  <FeaturedAward
    award={data.featuredAward.award}
    festival={data.featuredAward.festival}
    year={data.featuredAward.year}
    image={data.featuredAward.image}
    imageAlt={data.featuredAward.imageAlt}
    caption={data.featuredAward.caption}
  />
)}

{credits.length > 0 && (
  <section class="hero pt-20 pb-4">
    <div class="hero-content flex-col w-full">
      <SectionLabel label="Credits" />
      <div class="w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-10 px-6" data-aos="fade-up" data-aos-duration="600">
        <dl data-credit-column class="space-y-6 content-start text-base-200">
          {creditGroupsLeft.map((group) => (
            <CreditsItem
              crewfunction={group[0]?.function?.trim() || "Additional credits"}
              crewnames={group.map((credit) => credit.name)}
            />
          ))}
        </dl>
        <dl data-credit-column class="space-y-6 content-start text-base-200">
          {creditGroupsRight.map((group) => (
            <CreditsItem
              crewfunction={group[0]?.function?.trim() || "Additional credits"}
              crewnames={group.map((credit) => credit.name)}
            />
          ))}
        </dl>
      </div>
    </div>
  </section>
)}

{festivals.length > 0 && (
  <section class="hero pt-20 pb-4">
    <div class="hero-content flex-col w-full">
      <SectionLabel label="Festivals" />
      <FestivalList items={festivals} />
    </div>
  </section>
)}

{lists.map((l) => (
  <section class="hero pt-20 pb-4">
    <div class="hero-content flex-col w-full">
      <SectionLabel label={l.label} />
      <FestivalList items={l.items} />
    </div>
  </section>
))}

{laurels.length > 0 && (
  <section class="hero pt-20 pb-4">
    <div class="hero-content flex-col w-full">
      <SectionLabel label="Selections" />
      <div class="flex flex-wrap place-content-around">
        {laurels.map(async (l) => {
          const laurel = await resolveImage(l.image);
          return (
            <img
              src={laurel.src}
              width={laurel.width}
              height={laurel.height}
              alt={l.alt}
              class="w-48"
              loading="lazy"
            />
          );
        })}
      </div>
    </div>
  </section>
)}

{awards.length > 0 && (
  <section class="hero pt-20 pb-4">
    <div class="hero-content flex-col w-full">
      <SectionLabel label="Awards" />
      <ul class="w-full max-w-4xl mx-auto grid grid-cols-2 gap-y-1 px-6" data-aos="fade-up" data-aos-duration="600">
        {awards.map((a) => <AwardItem award={a.award} festival={a.festival} year={a.year} />)}
      </ul>
    </div>
  </section>
)}

{specs.length > 0 && (
  <section class="hero pt-20 pb-20">
    <div class="hero-content flex-col w-full">
      <SectionLabel label="Specs" />
      <dl id="specs" data-spec-list class="w-full max-w-2xl mx-auto space-y-5 px-6 text-base-200" data-aos="fade-up" data-aos-duration="600">
        {specGroups.map((group) => (
          <SpecItem
            label={group[0]?.label?.trim() || "Additional specs"}
            values={group.map((spec) => spec.value)}
          />
        ))}
      </dl>
    </div>
  </section>
)}

<section class="hero bg-neutral px-6 pt-16 pb-20" aria-labelledby="project-contact-heading">
  <div class="hero-content flex-col max-w-2xl mx-auto text-center">
    <h2 id="project-contact-heading" class="font-sans text-sm tracking-[0.2em] uppercase text-base-100/60 pb-5">Start a project</h2>
    <p class="font-serif text-xl sm:text-2xl text-base-100/90">Interested in working together? Get in touch to discuss your next production.</p>
    <a href="/about/#contact" class="mt-7 inline-flex items-center rounded-sm border border-secondary bg-secondary px-5 py-3 font-sans text-xs tracking-[0.16em] uppercase text-neutral transition-colors duration-200 hover:bg-transparent hover:text-secondary focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-secondary focus-visible:outline-offset-2">Discuss a project <span class="ml-2" aria-hidden="true">&rarr;</span></a>
  </div>
</section>

{prev && (
  <a href={prev.url} class="block bg-neutral py-6 text-center group focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-secondary" data-aos="fade-up" data-aos-duration="600">
    <span class="font-sans text-xs tracking-widest uppercase text-base-100/50 group-hover:text-secondary transition-colors duration-300">
      <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1">&larr;</span> Previous project &middot; <span class="text-base-100/80">{prev.title}</span>
    </span>
  </a>
)}
<NextProject title={next.title} url={next.url} image={next.image} imageposition={next.position} />

<style is:global>
  .project-copy > p {
    max-width: 48rem;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1.5rem;
    padding-left: 1.5rem;
    color: rgb(239 240 246 / 0.85);
    font-family: var(--font-eb-garamond), serif;
    font-size: clamp(1.125rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }

  .project-copy > p:first-child {
    margin-top: 1.5rem;
  }

  .project-copy > p + p {
    margin-top: 1.5rem;
  }
</style>

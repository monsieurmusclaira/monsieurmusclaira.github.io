---
import { SITE_NAME, SOCIAL_LINKS } from "../config";
const pathname = Astro.url.pathname;
// Exact match on the normalized path. `startsWith` would also light up a
// future sibling route like /about-me under the /about link.
const norm = (p: string) => p.split('#')[0].replace(/\/+$/, '') || '/';
const isActive = (href: string) => norm(pathname) === norm(href);
const linkClass = (href: string) =>
  `font-sans text-xs tracking-widest uppercase transition-colors duration-200 ${
    isActive(href) ? 'text-secondary' : 'text-base-100 hover:text-secondary'
  }`;
const current = (href: string) => (isActive(href) ? 'page' : undefined);
// daisyUI's .menu focus indicator computes to a 10% near-black tint on a
// near-black surface, which is invisible. Give the mobile links an explicit
// ring, inset so it stays inside the dropdown's rounded box.
const menuFocus =
  'focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-secondary';
---

<header class="fixed top-0 z-50 w-full transition-transform duration-300 focus-within:transition-none" id="site-nav">
<site-navigation style="display: contents">
<nav class="navbar bg-black/60 backdrop-blur-xs" aria-label="Main">
  <div class="navbar-start">
    <!-- Mobile: hamburger (real disclosure — aria-expanded/controls toggled by script) -->
    <div class="dropdown lg:hidden" id="menu-dropdown">
      <button
        id="menu-toggle"
        class="btn btn-ghost btn-circle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="#F1D74E" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
      </button>
      <!-- Without JavaScript the links remain a normal list. The navigation
           element owns disclosure state once it connects. -->
      <ul id="mobile-menu" class="menu menu-sm dropdown-content mt-3 p-2 shadow-sm bg-black/80 backdrop-blur-xs rounded-box w-52 text-base-100">
        <li>
          <a href="/" aria-current={current('/')} class={`${isActive('/') ? 'text-secondary font-semibold' : ''} ${menuFocus}`}>Work</a>
        </li>
        <li>
          <a href="/about/" aria-current={current('/about')} class={`${isActive('/about') ? 'text-secondary font-semibold' : ''} ${menuFocus}`}>About</a>
        </li>
        <li>
          <a href="/behind-the-scenes/" aria-current={current('/behind-the-scenes')} class={`${isActive('/behind-the-scenes') ? 'text-secondary font-semibold' : ''} ${menuFocus}`}>Behind the Scenes</a>
        </li>
        <li>
          <a href="/about/#contact" class={menuFocus}>Contact</a>
        </li>
      </ul>
    </div>
    <!-- Desktop: inline links -->
    <div id="desktop-links" class="hidden lg:flex items-center gap-7 pl-3">
      <a href="/" aria-current={current('/')} class={linkClass('/')}>Work</a>
      <a href="/about/" aria-current={current('/about')} class={linkClass('/about')}>About</a>
      <a href="/behind-the-scenes/" aria-current={current('/behind-the-scenes')} class={linkClass('/behind-the-scenes')}>Behind the Scenes</a>
      <a href="/about/#contact" class="font-sans text-xs tracking-widest uppercase transition-colors duration-200 text-base-100 hover:text-secondary">Contact</a>
    </div>
  </div>

  <div class="navbar-center">
    <a href="/" class="font-sans text-sm font-light tracking-widest uppercase text-base-100 hover:text-secondary transition-colors duration-200">
      {SITE_NAME}
    </a>
  </div>

  <div class="navbar-end">
    <div class="flex items-center gap-1 pr-1 sm:pr-3">
      <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram (opens in a new tab)" class="inline-flex items-center justify-center min-h-11 min-w-11 text-base-100/80 hover:text-secondary transition-colors duration-200">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href={SOCIAL_LINKS.imdb} target="_blank" rel="noopener noreferrer" aria-label="IMDb (opens in a new tab)" class="inline-flex items-center justify-center min-h-11 min-w-11 text-base-100/80 hover:text-secondary transition-colors duration-200">
        <span class="inline-flex items-center h-5 text-[11px] font-bold tracking-tight border border-current rounded-sm px-1.5 leading-none">IMDb</span>
      </a>
    </div>
  </div>
</nav>
</site-navigation>
</header>

<script>
  import '../lib/site-navigation';
</script>

<style is:global>
  /* The head sets .js before first paint. Reserve the enhanced header's
     geometry while its module loads; show a normal list only without JS. */
  html:not(.js) #menu-dropdown:not(.js-menu) #menu-toggle {
    display: none;
  }

  html:not(.js) #menu-dropdown:not(.js-menu) #mobile-menu {
    position: static;
    display: flex !important;
    opacity: 1;
    scale: 1;
  }
</style>

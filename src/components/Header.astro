---
const pathname = Astro.url.pathname;
// Exact match on the normalized path. `startsWith` would also light up a
// future sibling route like /about-me under the /about link.
const norm = (p: string) => p.split('#')[0].replace(/\/+$/, '') || '/';
const isActive = (href: string) => norm(pathname) === norm(href);
const linkClass = (href: string) =>
  `font-sans text-xs tracking-widest uppercase transition-colors duration-200 ${
    isActive(href) ? 'text-secondary' : 'text-base-100 hover:text-secondary'
  }`;
const current = (href: string) => (isActive(href) ? 'page' : undefined);
// daisyUI's .menu focus indicator computes to a 10% near-black tint on a
// near-black surface, which is invisible. Give the mobile links an explicit
// ring, inset so it stays inside the dropdown's rounded box.
const menuFocus =
  'focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-secondary';
---

<header class="fixed top-0 z-50 w-full transition-transform duration-300" id="site-nav">
<nav class="navbar bg-black/60 backdrop-blur-xs" aria-label="Main">
  <div class="navbar-start">
    <!-- Mobile: hamburger (real disclosure — aria-expanded/controls toggled by script) -->
    <div class="dropdown lg:hidden" id="menu-dropdown">
      <button
        id="menu-toggle"
        class="btn btn-ghost btn-circle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="#F1D74E" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
      </button>
      <!-- The links stay available if JavaScript fails. `attachMenu` adds the
           hidden state once the disclosure behaviour has been initialised. -->
      <ul id="mobile-menu" class="menu menu-sm dropdown-content mt-3 p-2 shadow-sm bg-black/80 backdrop-blur-xs rounded-box w-52 text-base-100">
        <li>
          <a href="/" aria-current={current('/')} class={`${isActive('/') ? 'text-secondary font-semibold' : ''} ${menuFocus}`}>Work</a>
        </li>
        <li>
          <a href="/about/" aria-current={current('/about')} class={`${isActive('/about') ? 'text-secondary font-semibold' : ''} ${menuFocus}`}>About</a>
        </li>
        <li>
          <a href="/behind-the-scenes/" aria-current={current('/behind-the-scenes')} class={`${isActive('/behind-the-scenes') ? 'text-secondary font-semibold' : ''} ${menuFocus}`}>Behind the Scenes</a>
        </li>
        <li>
          <a href="/about/#contact" class={menuFocus}>Contact</a>
        </li>
      </ul>
    </div>
    <!-- Desktop: inline links -->
    <div class="hidden lg:flex items-center gap-7 pl-3">
      <a href="/" aria-current={current('/')} class={linkClass('/')}>Work</a>
      <a href="/about/" aria-current={current('/about')} class={linkClass('/about')}>About</a>
      <a href="/behind-the-scenes/" aria-current={current('/behind-the-scenes')} class={linkClass('/behind-the-scenes')}>Behind the Scenes</a>
      <a href="/about/#contact" class="font-sans text-xs tracking-widest uppercase transition-colors duration-200 text-base-100 hover:text-secondary">Contact</a>
    </div>
  </div>

  <div class="navbar-center">
    <a href="/" class="font-sans text-sm font-light tracking-widest uppercase text-base-100 hover:text-secondary transition-colors duration-200">
      Victor Maes
    </a>
  </div>

  <div class="navbar-end">
    <div class="flex items-center gap-4 pr-3">
      <a href="https://www.instagram.com/monsieur_musclaira/" target="_blank" rel="noopener noreferrer" aria-label="Instagram (opens in a new tab)" class="inline-flex items-center h-5 text-base-100/80 hover:text-secondary transition-colors duration-200">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
      <a href="https://www.imdb.com/name/nm4866929" target="_blank" rel="noopener noreferrer" aria-label="IMDb (opens in a new tab)" class="inline-flex items-center h-5 text-base-100/80 hover:text-secondary transition-colors duration-200">
        <span class="inline-flex items-center h-5 text-[11px] font-bold tracking-tight border border-current rounded-sm px-1.5 leading-none">IMDb</span>
      </a>
    </div>
  </div>
</nav>
</header>

<script is:inline>
  (function () {
    // Astro can execute this inline script again after a client-side
    // navigation. Tear down the previous controller first so listeners never
    // accumulate and each new header has one owner.
    var previous = window.__siteNavController;
    if (previous && previous.destroy) previous.destroy();

    var nav = document.getElementById('site-nav');
    var menuButton;
    var menuElement;
    var lastY = 0;
    var ticking = false;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(function () {
          var y = window.scrollY;
          if (y > lastY && y > 80) {
            nav.style.transform = 'translateY(-100%)';
          } else {
            nav.style.transform = 'translateY(0)';
          }
          lastY = y;
          ticking = false;
        });
        ticking = true;
      }
    }

    function attachScroll() {
      nav = document.getElementById('site-nav');
      if (!nav) return;
      // Reduced motion: leave the bar pinned, never translate it out of view.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        nav.style.transform = '';
        window.removeEventListener('scroll', onScroll);
        return;
      }
      lastY = window.scrollY;
      window.removeEventListener('scroll', onScroll);
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // Mobile menu disclosure. Document-level listeners are defined once at module
    // scope and re-bound with remove-before-add so client-side navigation never
    // stacks duplicates.
    // daisyUI hides .dropdown-content unless the .dropdown container has
    // .dropdown-open or matches :focus-within. Safari does not focus a
    // <button> on click, so :focus-within never matches there. Toggle
    // .dropdown-open explicitly alongside .hidden.
    function setMenu(open) {
      var btn = document.getElementById('menu-toggle');
      var menu = document.getElementById('mobile-menu');
      var wrap = document.getElementById('menu-dropdown');
      if (!btn || !menu || !wrap) return;
      menu.classList.toggle('hidden', !open);
      wrap.classList.toggle('dropdown-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    }

    function closeMenu(restoreFocus) {
      setMenu(false);
      if (restoreFocus) {
        var btn = document.getElementById('menu-toggle');
        if (btn) btn.focus();
      }
    }

    function onMenuLinkClick() { closeMenu(false); }

    function onDocClick(e) {
      var btn = document.getElementById('menu-toggle');
      var menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      if (!menu.contains(e.target) && !btn.contains(e.target)) closeMenu();
    }

    function onKeydown(e) {
      if (e.key === 'Escape' && document.getElementById('menu-toggle')?.getAttribute('aria-expanded') === 'true') {
        e.preventDefault();
        closeMenu(true);
      }
    }

    function onFocusIn(e) {
      nav = document.getElementById('site-nav');
      if (nav && nav.contains(e.target)) nav.style.transform = 'translateY(0)';
    }

    function onToggleClick(e) {
      e.stopPropagation();
      var btn = document.getElementById('menu-toggle');
      if (!btn) return;
      setMenu(btn.getAttribute('aria-expanded') !== 'true');
    }

    function attachMenu() {
      var btn = document.getElementById('menu-toggle');
      var menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      menuButton = btn;
      menuElement = menu;
      var wrap = document.getElementById('menu-dropdown');
      if (wrap) wrap.classList.add('js-menu');
      // Hide only after JavaScript has attached. Without JS this menu remains
      // a normal list of links (progressive enhancement).
      setMenu(false);
      btn.removeEventListener('click', onToggleClick);
      btn.addEventListener('click', onToggleClick);
      menu.querySelectorAll('a').forEach(function (a) {
        a.removeEventListener('click', onMenuLinkClick);
        a.addEventListener('click', onMenuLinkClick);
      });
      document.removeEventListener('click', onDocClick);
      document.addEventListener('click', onDocClick);
      document.removeEventListener('keydown', onKeydown);
      document.addEventListener('keydown', onKeydown);
      document.removeEventListener('focusin', onFocusIn);
      document.addEventListener('focusin', onFocusIn);
    }

    function setup() {
      attachScroll();
      attachMenu();
    }

    function destroy() {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('click', onDocClick);
      document.removeEventListener('keydown', onKeydown);
      document.removeEventListener('focusin', onFocusIn);
      document.removeEventListener('astro:page-load', setup);
      if (menuButton) menuButton.removeEventListener('click', onToggleClick);
      if (menuElement) {
        menuElement.querySelectorAll('a').forEach(function (a) {
          a.removeEventListener('click', onMenuLinkClick);
        });
      }
    }

    window.__siteNavController = { destroy: destroy };
    setup();
    document.addEventListener('astro:page-load', setup);
  })();
</script>

<style is:global>
  /* Keep the mobile links usable when JavaScript is unavailable. Once the
     disclosure controller attaches, `.js-menu` restores the dropdown UI. */
  #menu-dropdown:not(.js-menu) #menu-toggle {
    display: none;
  }

  #menu-dropdown:not(.js-menu) #mobile-menu {
    position: static;
    display: flex !important;
    opacity: 1;
    scale: 1;
  }
</style>

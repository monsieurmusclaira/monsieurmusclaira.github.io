---
const { title, subtitle, variant, href } = Astro.props;
---
<figure class={`scrapbook-note ${variant ? 'note-' + variant : ''}`} data-aos="fade-up" data-aos-duration="500">
    <h2 class="note-title">
        {title}
    </h2>
    {subtitle && <p class="note-sub">{subtitle}</p>}
    {href && (
        <a href={href} class="note-sub mt-2 inline-block text-inherit underline focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current">
            View project &rarr;
        </a>
    )}
</figure>

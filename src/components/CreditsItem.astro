---
interface Props { crewfunction: string; crewnames?: string[]; }
const { crewfunction, crewnames = [] } = Astro.props;
---
<div
  data-credit-group
  class="grid grid-cols-[minmax(6.5rem,0.85fr)_minmax(0,1.15fr)] gap-x-5 border-t border-base-100/10 pt-4"
>
  <dt class="text-right pt-0.5">
    <span class="font-sans text-[11px] leading-relaxed tracking-widest uppercase text-base-100/60">
      {crewfunction}
    </span>
  </dt>
  <dd class="min-w-0">
    <ul class="space-y-1.5">
      {crewnames.map((name) => (
        <li class="font-sans text-base leading-snug font-light text-base-100/80 break-words">
          {name}
        </li>
      ))}
    </ul>
  </dd>
</div>
